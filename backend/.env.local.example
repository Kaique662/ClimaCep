# Exemplo APENAS. Copie para .env.local; nunca coloque a senha real neste arquivo.
# .env.local nao e lido automaticamente pelo Spring Boot; use o script 02-iniciar-backend.ps1.
DB_URL=jdbc:postgresql://aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=aws-1-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.USERNAME
DB_PASSWORD=COLOQUE_A_SENHA_DO_BANCO_SUPABASE
APP_JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_COM_PELO_MENOS_32_CARACTERES
PORT=8080
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=30000
